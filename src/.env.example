# ============================================================
# AI Emergency Operations & Resource Orchestration System
# Environment Configuration
# ============================================================
# Copy this file to .env and fill in values as needed.
# NEVER commit the .env file — it is in .gitignore.
# The system works fully without any credentials (deterministic mode).
# ============================================================

# ── Application ─────────────────────────────────────────── REQUIRED
APP_PORT=8000
APP_ENV=development
DEBUG=true

# ── Database ─────────────────────────────────────────────── OPTIONAL
# Defaults to SQLite (local file). Change to PostgreSQL for production.
# DEMO: Leave as SQLite (default — no configuration needed)
DATABASE_URL=sqlite+aiosqlite:///./disaster_response.db
# PRODUCTION example:
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/disaster_response

# ── IBM watsonx.ai ────────────────────────────────────────── OPTIONAL
# If not configured, the system uses the deterministic AI provider (fully functional).
# Set these only if you have IBM watsonx.ai credentials.
WATSONX_API_KEY=
WATSONX_PROJECT_ID=
WATSONX_URL=https://us-south.ml.cloud.ibm.com
WATSONX_MODEL_ID=ibm/granite-3-8b-instruct

# ── MCP Server ────────────────────────────────────────────── OPTIONAL
# URL that the MCP server uses to connect to the backend.
# Must match APP_PORT above.
BACKEND_URL=http://localhost:8000

# ── Source Reliability (configurable defaults) ─────────────── OPTIONAL
# These are simulation defaults, not claims about real-world reliability.
# RELIABILITY_SATELLITE=0.85
# RELIABILITY_DRONE=0.90
# RELIABILITY_FIELD_REPORT=0.88
# RELIABILITY_HOSPITAL=0.95

# ── Freshness Decay (hours^-1) ────────────────────────────── OPTIONAL
# freshness = exp(-lambda * age_hours)
# Higher lambda = faster decay
# FRESHNESS_LAMBDA_BRIDGE_STATUS=2.0
# FRESHNESS_LAMBDA_ROAD_STATUS=1.5
# FRESHNESS_LAMBDA_HOSPITAL_CAPACITY=2.0
# FRESHNESS_LAMBDA_POPULATION=0.1
